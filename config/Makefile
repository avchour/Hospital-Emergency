####### Compile

main.o: src/main.cpp src/gui/include/mainwindow.h \
		src/include/PatientManager.h \
		src/model/Patient.h \
		src/include/PriorityQueue.h \
		src/model/triage.h \
		src/include/Queue.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o src/main.cpp

PatientManager.o: src/data/PatientManager.cpp src/include/PatientManager.h \
		src/model/Patient.h \
		src/include/utils.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o PatientManager.o src/data/PatientManager.cpp

PriorityQueue.o: src/data/PriorityQueue.cpp src/include/PriorityQueue.h \
		src/include/PatientManager.h \
		src/model/Patient.h \
		src/model/triage.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o PriorityQueue.o src/data/PriorityQueue.cpp

utils.o: src/data/utils.cpp src/include/utils.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o utils.o src/data/utils.cpp

mainwindow.o: src/gui/data/mainwindow.cpp src/gui/include/mainwindow.h \
		src/include/PatientManager.h \
		src/model/Patient.h \
		src/include/PriorityQueue.h \
		src/model/triage.h \
		src/include/Queue.h \
		src/gui/include/dashboard.h \
		src/gui/include/patient.h \
		src/gui/include/triage.h \
		src/gui/include/emergency.h \
		src/gui/include/treatment.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o mainwindow.o src/gui/data/mainwindow.cpp

patient.o: src/gui/data/patient.cpp src/gui/include/patient.h \
		src/include/PatientManager.h \
		src/model/Patient.h \
		src/include/utils.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o patient.o src/gui/data/patient.cpp

dashboard.o: src/gui/data/dashboard.cpp src/gui/include/dashboard.h \
		src/include/PatientManager.h \
		src/model/Patient.h \
		src/include/PriorityQueue.h \
		src/model/triage.h \
		src/include/Queue.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o dashboard.o src/gui/data/dashboard.cpp

triage.o: src/gui/data/triage.cpp src/gui/include/triage.h \
		src/include/PatientManager.h \
		src/model/Patient.h \
		src/include/PriorityQueue.h \
		src/model/triage.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o triage.o src/gui/data/triage.cpp

emergency.o: src/gui/data/emergency.cpp src/gui/include/emergency.h \
		src/model/Patient.h \
		src/model/triage.h \
		src/include/PatientManager.h \
		src/include/PriorityQueue.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o emergency.o src/gui/data/emergency.cpp

treatment.o: src/gui/data/treatment.cpp src/gui/include/treatment.h \
		src/include/PatientManager.h \
		src/model/Patient.h \
		src/include/Queue.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o treatment.o src/gui/data/treatment.cpp

qrc_resources.o: qrc_resources.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o qrc_resources.o qrc_resources.cpp

moc_mainwindow.o: moc_mainwindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_mainwindow.o moc_mainwindow.cpp

moc_dashboard.o: moc_dashboard.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_dashboard.o moc_dashboard.cpp

moc_patient.o: moc_patient.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_patient.o moc_patient.cpp

moc_triage.o: moc_triage.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_triage.o moc_triage.cpp

moc_emergency.o: moc_emergency.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_emergency.o moc_emergency.cpp

