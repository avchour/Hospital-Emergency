dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents resources/resources.qrc $(DISTDIR)/
	$(COPY_FILE) --parents /usr/lib64/qt6/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents src/include/PatientManager.h src/include/PriorityQueue.h src/include/Queue.h src/include/utils.h src/model/Patient.h src/model/triage.h src/gui/include/mainwindow.h src/gui/include/dashboard.h src/gui/include/patient.h src/gui/include/triage.h src/gui/include/emergency.h src/gui/include/treatment.h $(DISTDIR)/
	$(COPY_FILE) --parents src/main.cpp src/data/PatientManager.cpp src/data/PriorityQueue.cpp src/data/utils.cpp src/gui/data/mainwindow.cpp src/gui/data/patient.cpp src/gui/data/dashboard.cpp src/gui/data/triage.cpp src/gui/data/emergency.cpp src/gui/data/treatment.cpp $(DISTDIR)/


clean: compiler_clean 
	-$(DEL_FILE) $(OBJECTS)
	-$(DEL_FILE) *~ core *.core


distclean: clean 
	-$(DEL_FILE) $(TARGET) 
	-$(DEL_FILE) .qmake.stash
	-$(DEL_FILE) Makefile


