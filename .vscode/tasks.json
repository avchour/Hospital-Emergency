{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Qt: Auto Clean, Config and Build",
      "type": "shell",
      "command": "cmd /c \"mingw32-make clean && C:/Qt/6.12.0/mingw_64/bin/qmake.exe hospital.pro && mingw32-make -j4\"",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:/Qt/Tools/mingw1510_64/bin;C:/Qt/6.12.0/mingw_64/bin;${env:SystemRoot}/system32;${env:SystemRoot};${env:PATH}"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Qt: Clean Hospital System",
      "type": "process",
      "command": "C:/Qt/Tools/mingw1510_64/bin/mingw32-make.exe",
      "args": ["clean"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:/Qt/Tools/mingw1510_64/bin;C:/Qt/6.12.0/mingw_64/bin;${env:SystemRoot}/system32;${env:SystemRoot};${env:PATH}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Qt: Configure Hospital System",
      "type": "process",
      "command": "C:/Qt/6.12.0/mingw_64/bin/qmake.exe",
      "args": ["hospital.pro"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:/Qt/Tools/mingw1510_64/bin;C:/Qt/6.12.0/mingw_64/bin;${env:SystemRoot}/system32;${env:SystemRoot};${env:PATH}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Qt: Build Hospital System",
      "type": "process",
      "command": "C:/Qt/Tools/mingw1510_64/bin/mingw32-make.exe",
      "args": ["-j4"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:/Qt/Tools/mingw1510_64/bin;C:/Qt/6.12.0/mingw_64/bin;${env:SystemRoot}/system32;${env:SystemRoot};${env:PATH}"
        }
      },
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Qt: Run Hospital System",
      "type": "process",
      "command": "${workspaceFolder}/release/HospitalSystem.exe",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:/Qt/6.12.0/mingw_64/bin;C:/Qt/Tools/mingw1510_64/bin;${env:SystemRoot}/system32;${env:SystemRoot};${env:PATH}"
        }
      },
      "problemMatcher": []
    }
  ]
}