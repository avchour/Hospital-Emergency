/* ==========================================================
   GLOBAL APPLICATION TYPOGRAPHY
   Primary Font: Gotham
   Fallback Font: Montserrat (Cross-platform: Windows & Fedora)
   ========================================================== */

* {
    font-family: "Gotham", "Montserrat", "Segoe UI", "Cantarell", "Liberation Sans", "DejaVu Sans", sans-serif;
}

QWidget, QLabel, QPushButton, QTableWidget, QTableView, QHeaderView, QHeaderView::section, QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit, QFrame {
    font-family: "Gotham", "Montserrat", "Segoe UI", "Cantarell", "Liberation Sans", "DejaVu Sans", sans-serif;
}

/* ==========================================================
   13. DASHBOARD
   🎨 MODERN XIU XIAN
   ========================================================== */

QWidget#dashboardPage,
QWidget#dashboardContainer,
QScrollArea#dashboardScroll,
QScrollArea#dashboardScroll > QWidget > QWidget {
     background-color: #F7F8FA;
     border: none;
}

/* 🧪 Sample-data indicator */
QLabel#demoBadge {
    background-color: #F7F0DF;
    color: #92702F;
    border: 1px solid #D9AD52;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 10px;
    font-weight: bold;
}

/* 🚨 Emergency overview */
/* ✏️ MANUAL CHANGE: Panel headings */
QLabel#sectionTitle {
    color: #172337;
    font-size: 17px;
    font-weight: bold;
}
QLabel#severityLabel {
    color: #344054;
    font-size: 12px;
    border: none;
}

QLabel#severityCount {
    color: #92702F;
    font-size: 12px;
    font-weight: bold;
    border: none;
}

/* Progress bars */
QProgressBar {
    background-color: #EAECF0;
    border: none;
    border-radius: 4px;
}

QProgressBar::chunk {
    border-radius: 4px;
}

QProgressBar#criticalBar::chunk {
    background-color: #EF4444;
}

QProgressBar#majorBar::chunk {
    background-color: #F97316;
}

QProgressBar#moderateBar::chunk {
    background-color: #EAB308;
}

QProgressBar#minorBar::chunk {
    background-color: #22C55E;
}

/* 🕘 Recent activities */
/* ✏️ MANUAL CHANGE: Panel headings */
QLabel#sectionTitle {
    color: #172337;
    font-size: 17px;
    font-weight: bold;
}
QLabel#activityText {
    color: #344054;
    font-size: 12px;
    border: none;
}

QLabel#activityTime {
    color: #98A2B3;
    font-size: 11px;
    border: none;
}

/* ✨ Quick actions */
QPushButton#quickActionButton {
    background-color: #F7F0DF;
    color: #92702F;
    border: 1px solid #D9AD52;
    border-radius: 9px;
    padding: 10px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton#quickActionButton:hover {
    background-color: #EFE1BF;
    border: 1px solid #B58A35;
}

QPushButton#quickActionButton:pressed {
    background-color: #E6D5AD;
}

/* Dashboard content panels */
QFrame#contentPanel {
    background-color: #FFFFFF;
    border: 1px solid #E6E0D2;
    border-radius: 12px;
}

/* Dashboard cards */
QFrame#dashboardCard {
    background-color: #FFFFFF;
    border: 1px solid #E6E0D2;
    border-radius: 12px;
}

QFrame#dashboardCard:hover {
    border: 1px solid #D9AD52;
}
/* ✏️ MANUAL CHANGE: Dashboard heading colors */
QLabel#pageTitle {
    color: #172337;
    font-size: 24px;
    font-weight: bold;
}

QLabel#pageSubtitle {
    color: #7B8798;
    font-size: 13px;
}

QLabel#cardTitle {
    color: #7B8798;
}

QLabel#cardValue {
    color: #B58A35;
    font-size: 28px;
    font-weight: bold;
}

QLabel#cardDescription {
    color: #667085;
}
/* =========================================
   PATIENT TABLE - LIGHT THEME
   ========================================= */

/* ✏️ MANUAL CHANGE: Main table appearance */
QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F8F9FC;
    color: #344054;
    border: none;
    gridline-color: #EAECF0;
    selection-background-color: #F5EBD5;
    selection-color: #172337;
}

/* ✏️ MANUAL CHANGE: Table header */
QHeaderView::section {
    background-color: #F5F6F8;
    color: #344054;
    padding: 10px;
    border: none;
    border-bottom: 1px solid #E5E7EB;
    font-weight: bold;
}


/* ==========================================================
   SIDEBAR - HOSPITAL NAVY & IMPERIAL GOLD
   ========================================================== */

QWidget#sidebar {
    background-color: #151D2B;
}

/* Brand emblem */
QLabel#brandIcon {
    background-color: #C49A45;
    color: #151D2B;
    border-radius: 9px;
    font-size: 29px;
    font-weight: bold;
}

/* Brand title */
QLabel#brandTitle {
    color: #F5F0E5;
    font-size: 14px;
    font-weight: bold;
    border: none;
}

/* Brand subtitle */
QLabel#brandSubtitle {
    color: #AAB5C5;
    font-size: 10px;
    border: none;
}

/* Main menu heading */
QLabel#menuHeading {
    color: #8D9AAF;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
    border: none;
    padding-left: 5px;
}

/* Navigation buttons */
QPushButton#navButton {
    background-color: transparent;
    color: #C5CEDB;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 6px;
    text-align: left;
    padding: 12px 12px;
    font-size: 12px;
    font-weight: normal;
}

/* Hover state */
QPushButton#navButton:hover {
    background-color: #263449;
    color: #FFFFFF;
}

/* Active page */
QPushButton#navButton:checked {
    background-color: #344052;
    color: #E6C477;
    border-left: 3px solid #C49A45;
    font-weight: bold;
}

/* Footer profile card */
QFrame#sidebarFooterCard {
    background-color: #202C3D;
    border: 1px solid #344052;
    border-radius: 9px;
}

/* Administrator avatar */
QLabel#adminAvatar {
    background-color: #C49A45;
    color: #151D2B;
    border-radius: 18px;
    font-size: 15px;
    font-weight: bold;
    border: none;
}

/* Administrator name */
QLabel#adminName {
    color: #F5F0E5;
    font-size: 12px;
    font-weight: bold;
    border: none;
}

/* Green online indicator */
QLabel#statusDot {
    color: #22C55E;
    font-size: 9px;
    border: none;
}

/* System status */
QLabel#systemStatus {
    color: #AAB5C5;
    font-size: 10px;
    border: none;
}

/* ==========================================================
   SCROLLBAR STYLING - GLOBAL
   ========================================================== */

QScrollBar:vertical {
    background-color: #F1F5F9;
    width: 12px;
    margin: 0px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #94A3B8;
    min-height: 36px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background-color: #64748B;
}

QScrollBar::handle:vertical:pressed {
    background-color: #475569;
}

QScrollBar::sub-line:vertical, QScrollBar::add-line:vertical {
    height: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #F1F5F9;
    height: 12px;
    margin: 0px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #94A3B8;
    min-width: 36px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #64748B;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #475569;
}

QScrollBar::sub-line:horizontal, QScrollBar::add-line:horizontal {
    width: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}
